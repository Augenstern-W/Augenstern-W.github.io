<header class="navbar navbar-inverse" id="gal-header">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed"
                    data-toggle="collapse" data-target=".bs-navbar-collapse"
                    aria-expanded="false">
                <span class="fa fa-lg fa-reorder"></span>
            </button>
            <a href="<%= config.url %>">
                <% if(theme.use_logo === true) {
                	if(/https?:\/\//.test(theme.logo_image)) { %>
                <!-- 这里background直接使用logo_image(url) -->
                <style>

                </style>
                    <% } else { %>
                <!-- 这里background使用imgs/${logo_image}(路径文件名) -->
                <style>
                    #gal-header .navbar-brand {
                        width: 200px;
                        height: 50px;
                        display: block;
                        background: url('<%= url_for(`imgs/${theme.logo_image}`) %>') no-repeat;
                    }
                </style>
                    <% } %>
                <div class="navbar-brand"></div>
                <% } else { %>
                <style>
                    #gal-header .navbar-brand {
                        height: 54px;
                        line-height: 24px;
                        font-size: 28px;
                        opacity: 1;
                        background-color: rgba(0,0,0,0);
                        text-shadow: 0 0 5px #fff,0 0 10px #fff,0 0 15px #fff,0 0 20px #228DFF,0 0 35px #228DFF,0 0 40px #228DFF,0 0 50px #228DFF,0 0 75px #228DFF;
                    }
                </style>
                <!-- 这里使用文字(navbar_text or config.title) -->
                <div class="navbar-brand"><%= theme.navbar_text ? theme.navbar_text : config.title %></div>
                <% } %>
            </a>
        </div>
        <div class="collapse navbar-collapse bs-navbar-collapse">
            <ul class="nav navbar-nav" id="menu-gal">
                <% theme.menu.forEach(function (m) { %>
                <% if ((m.url === 'tags' || 'categories') && m.dropdown > 0) { %>
                <% if (m.url === 'tags' && site.tags.length === 0) { %>
                <li class="<%= path.includes(m.url) ? 'current' : '' %>">
                    <a href="<%- url_for(m.url) %>">
                        <i class="fa fa-<%= m.icon %>"></i><%= m.title %>
                    </a>
                </li>
                <% } else if(m.url === 'categories' && site.categories.length === 0) { %>
                <li class="<%= path.includes(m.url) ? 'current' : '' %>">
                    <a href="<%- url_for(m.url) %>">
                        <i class="fa fa-<%= m.icon %>"></i><%= m.title %>
                    </a>
                </li>
                <% } else { %>
                <li class="dropdown">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown"
                       aria-haspopup="true" aria-expanded="false" data-hover="dropdown">
                        <i class="fa fa-<%= m.icon %>"></i><%= m.title %>
                    </a>
                    <% var galDropdownItems = (m.url === 'categories') ? site.categories : site.tags; %>
                    <ul class="dropdown-menu gal-dropdown-menu">
                        <li class="gal-dropdown-search">
                            <form role="search" onsubmit="return false;">
                                <input type="text" class="gal-tag-search" placeholder="输入关键词筛选..." autocomplete="off">
                            </form>
                        </li>
                        <% galDropdownItems.forEach(function (item) { %>
                        <li class="gal-dropdown-item" data-name="<%= String(item.name).toLowerCase() %>">
                            <a href="<%- url_for(item.path) %>"><%= item.name %></a>
                        </li>
                        <% }) %>
                        <li class="gal-dropdown-empty">无匹配结果</li>
                    </ul>
                </li>
                <% } %>
                <% } else { %>
                <li class="<%= ((m.url === '/' && path === 'index.html') || (m.url !== '/' && path.includes(m.url))) ? 'current' : '' %>">
                    <a href="<%- url_for(m.url) %>">
                        <i class="fa fa-<%= m.icon %>"></i><%= m.title %>
                    </a>
                </li>
                <% } %>
                <% }) %>
            </ul>
        </div>
    </div>
</header>
<style>
#gal-header .gal-dropdown-menu {
    max-height: 65vh;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
}
#gal-header .gal-dropdown-search {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 5px 10px;
    background: #222;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
#gal-header .gal-dropdown-search input {
    width: 100%;
    height: 28px;
    padding: 2px 8px;
    font-size: 12px;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    outline: none;
}
#gal-header .gal-dropdown-search input:focus {
    border-color: #228DFF;
}
#gal-header .gal-dropdown-empty {
    display: none;
    padding: 6px 14px;
    color: #888;
    font-size: 12px;
}
</style>
<script>
(function () {
    document.addEventListener('input', function (e) {
        var input = e.target;
        if (!input.classList || !input.classList.contains('gal-tag-search')) return;
        var menu = input.closest('.dropdown-menu');
        if (!menu) return;
        var kw = input.value.trim().toLowerCase();
        var visible = 0;
        menu.querySelectorAll('.gal-dropdown-item').forEach(function (li) {
            var hit = !kw || li.getAttribute('data-name').indexOf(kw) !== -1;
            li.style.display = hit ? '' : 'none';
            if (hit) visible++;
        });
        var empty = menu.querySelector('.gal-dropdown-empty');
        if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
    });
})();
</script>